{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${PLUGIN_ROOT}\" bash \"${PLUGIN_ROOT}/hooks/check-ocloud\" codex",
            "timeout": 10,
            "statusMessage": "Checking ocloud CLI and Olef Cloud sign-in"
          }
        ]
      }
    ]
  }
}
