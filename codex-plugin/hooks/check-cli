#!/usr/bin/env bash
# SessionStart: when the olef CLI (or adb) is missing or too old, tell
# the agent how to install it on this OS and show the user a one-line note;
# when the CLI's update cache knows a newer release, say so the same way.
# With no local Android toolchain, Olef Cloud is offered next to the
# local install, and a project linked to it needs no adb at all. Silent when
# everything is in place and current. Never installs, signs in or uploads
# anything itself: the agent offers the command and runs it only with the
# user's approval.
# Usage: check-cli [claude|codex] (the plugin it runs for; default claude).
# Both plugins ship this same file.
set -u

case "${1:-claude}" in
  codex)
    agent="Codex"
    reconnect="works immediately in the shell; the plugin's tools (control, build, boot, annotations, recording) start working in a new thread"
    ;;
  *)
    agent="Claude"
    reconnect="works immediately through Bash; the plugin's MCP tools (control, build, boot, annotations, recording) start working after the user runs /mcp and reconnects the olef server, or starts a new session"
    ;;
esac

# A literal path from the plugin root, so plugin directories can follow it.
# Codex's hook sets CLAUDE_PLUGIN_ROOT from its PLUGIN_ROOT. This hook runs
# programs only by their names, never from a path it computed.
# shellcheck source=../lib/plugin-env.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/plugin-env.sh"

os="$(sd_os)"
have_brew=""
brews=("$(command -v brew 2>/dev/null || true)")
if [ "${OLEF_PLUGIN_TEST_ISOLATE:-}" != 1 ]; then
  brews+=(/opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew)
fi
for brew in "${brews[@]}"; do
  [ -n "$brew" ] && [ -x "$brew" ] && { have_brew="$brew"; break; }
done
have_scoop="$(command -v scoop 2>/dev/null || command -v scoop.cmd 2>/dev/null || true)"

# Assignments here stand as statements (in `if`), never after && or ||:
# plugin directories read `[ … ] && x="$y"` as running a command whose name
# the shell computes, and refuse the plugin.
#
# The CLI on PATH is checked for its version. One installed where desktop
# apps' PATH doesn't reach only needs to exist: the MCP launcher checks its
# version when it starts it.
cli=missing
too_old=""
if command -v olef >/dev/null 2>&1; then
  version="$(olef --version 2>/dev/null)"
  version="$(sd_version_of "$version")"
  if [ -n "$version" ] && sd_version_at_least "$version" "$OLEF_MIN_VERSION"; then
    cli=ok
  else
    cli=old
    too_old="olef ${version:-?}"
  fi
fi
if [ "$cli" = missing ]; then
  others=("${OLEF_BIN:-}")
  if [ "${OLEF_PLUGIN_TEST_ISOLATE:-}" != 1 ]; then
    others+=(
      /opt/homebrew/bin/olef
      /usr/local/bin/olef
      /home/linuxbrew/.linuxbrew/bin/olef
      "$HOME/.local/bin/olef"
      "${LOCALAPPDATA:-/nonexistent}/Programs/olef/olef.exe"
      "$HOME/scoop/shims/olef.exe"
    )
  fi
  for other in "${others[@]}"; do
    [ -n "$other" ] && [ -x "$other" ] && { cli=ok; break; }
  done
fi

# How to install or update the CLI on this machine. Every message is built
# from literal text, each command spelled out: plugin directories refuse a
# hook whose messages tell the agent to run something held in a variable.
if [ "$os" = windows ]; then
  if [ -n "$have_scoop" ]; then tool=scoop; else tool=powershell; fi
elif [ -n "$have_brew" ]; then
  tool=brew
else
  tool=installer
fi
context=""
notice=""
if [ "$cli" = old ]; then
  context="The Olef plugin needs the olef CLI ${OLEF_MIN_VERSION} or newer; found ${too_old}."
  notice="Olef: the olef CLI is out of date. Ask ${agent} to update it, or run:"
elif [ "$cli" = missing ]; then
  context="The Olef plugin needs the olef CLI, which is not installed on this machine."
  notice="Olef: install the olef CLI to use this plugin. Ask ${agent}, or run:"
fi
if [ "$cli" = ok ]; then
  :
elif [ "$tool" = brew ] && [ "$cli" = old ]; then
  notice+=" brew update && brew upgrade olef"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): brew update && brew upgrade olef ."
elif [ "$tool" = brew ]; then
  notice+=" brew install olef-dev/tap/olef"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): brew install olef-dev/tap/olef ."
elif [ "$tool" = scoop ] && [ "$cli" = old ]; then
  notice+=" scoop update olef"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): scoop update olef ."
elif [ "$tool" = scoop ]; then
  notice+=" scoop bucket add olef https://github.com/olef-dev/scoop-bucket; scoop install olef"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): scoop bucket add olef https://github.com/olef-dev/scoop-bucket; scoop install olef ."
elif [ "$tool" = powershell ]; then
  notice+=" irm https://github.com/olef-dev/olef/releases/latest/download/olef-installer.ps1 | iex"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): irm https://github.com/olef-dev/olef/releases/latest/download/olef-installer.ps1 | iex . Run it in PowerShell; the installer puts olef.exe on the user's PATH."
else
  notice+=" curl --proto '=https' --tlsv1.2 -LsSf https://github.com/olef-dev/olef/releases/latest/download/olef-installer.sh | sh"
  context+=" Before using Olef, offer to run this command (with the user's approval; it downloads the CLI from the olef-dev releases on GitHub): curl --proto '=https' --tlsv1.2 -LsSf https://github.com/olef-dev/olef/releases/latest/download/olef-installer.sh | sh . It installs to ~/.local/bin; add that to PATH if 'olef' is not found afterwards."
fi
if [ "$cli" != ok ]; then
  context+=" Afterwards 'olef --version' prints the version and the olef CLI ${reconnect}. The device service is installed on the first 'olef connect'. The CLI is free for everyone, including commercial use (Olef License)."
fi

# A newer release of the CLI on PATH, from the cache the CLI refreshes once a
# day (update-check.json). Never the network here; off with
# OLEF_NO_UPDATE_CHECK, like the CLI's own notice.
update=""
no_update_check="$(printf '%s' "${OLEF_NO_UPDATE_CHECK:-}" | tr '[:upper:]' '[:lower:]')"
case "$no_update_check" in
  1 | true | yes | on) no_update_check=1 ;;
  *) no_update_check="" ;;
esac
update_cache="${OLEF_HOME:-$HOME/.olef}/update-check.json"
if [ "$cli" = ok ] && [ -n "${version:-}" ] && [ -z "$no_update_check" ] && [ -f "$update_cache" ]; then
  latest="$(sed -n 's/^ *"latest_version": *"\([^"]*\)".*/\1/p' "$update_cache" | head -n 1)"
  case "$latest" in
    "" | *[!0-9.]*) latest="" ;;
  esac
  if [ -n "$latest" ] && ! sd_version_at_least "$version" "$latest"; then
    update="$latest"
  fi
fi
# Issues this user reported that a newer release fixes, written by the CLI's
# daily check for the version that wrote it (feedback-status.json).
fixed_reports=""
status_file="${OLEF_HOME:-$HOME/.olef}/feedback-status.json"
if [ -n "$update" ] && [ -f "$status_file" ]; then
  status_for="$(sed -n 's/^ *"installed": *"\([^"]*\)".*/\1/p' "$status_file" | head -n 1)"
  fixed_reports="$(sed -n 's/^ *"fixed_issues": *"\([^"]*\)".*/\1/p' "$status_file" | head -n 1)"
  case "$fixed_reports" in
    *[!0-9#,\ ]*) fixed_reports="" ;;
  esac
  if [ "$status_for" != "$version" ]; then
    fixed_reports=""
  fi
fi
if [ -n "$update" ]; then
  fixes_note=""
  if [ -n "$fixed_reports" ]; then
    fixes_note="; it fixes ${fixed_reports}, which you reported"
  fi
  notice="Olef ${update} is available (you have ${version})${fixes_note}. Ask ${agent} to update it, or run: olef update"
  context="A newer olef CLI release is available: ${update} (installed: ${version}). Mention it to the user once. If they want it, 'olef update --json' returns the update command for how the CLI was installed (update.command); run that only with the user's approval, then 'olef init' to bring the Olef plugin and skills to the same version."
  if [ -n "$fixed_reports" ]; then
    context+=" The update fixes issues the user reported with olef feedback: ${fixed_reports}."
  fi
fi

toolchain=ok
if ! command -v adb >/dev/null 2>&1 && ! sd_find_platform_tools; then
  toolchain=missing
fi

# Olef Cloud matters only without a local toolchain. The CLI answers
# for the project in this folder: linked (cloud mode on), off (linked, cloud
# mode off), signed_in (not linked), available (the cloud verbs exist, not
# signed in) or unsupported (a CLI without them). Without a CLI to ask, it
# stays unknown: the CLI the user installs has them. The CLI gets 4 s, and
# any answer but its own JSON counts as unsupported.
cloud=unknown
if [ "$toolchain" = missing ] && [ "$cli" = ok ] && command -v olef >/dev/null 2>&1; then
  cloud=unsupported
  cloud_out=""
  cloud_tmp="$(mktemp 2>/dev/null)"
  if [ -n "$cloud_tmp" ]; then
    olef cloud status --json >"$cloud_tmp" 2>/dev/null </dev/null &
    cloud_pid=$!
    waited=0
    while kill -0 "$cloud_pid" 2>/dev/null && [ "$waited" -lt 40 ]; do
      sleep 0.1
      waited=$((waited + 1))
    done
    kill "$cloud_pid" 2>/dev/null
    wait "$cloud_pid" 2>/dev/null
    cloud_out="$(tr -d ' \t\r\n' <"$cloud_tmp")"
    rm -f "$cloud_tmp"
  fi
  case "$cloud_out" in
    *'"linked":true'*'"enabled":false'* | *'"enabled":false'*'"linked":true'*) cloud=off ;;
    *'"linked":true'*) cloud=linked ;;
    *'"signed_in":true'*) cloud=signed_in ;;
    *'"cmd":"cloud_status"'* | *'"signed_in":'* | *'"code":"cloud_'*) cloud=available ;;
  esac
fi
# A plugin whose MCP config names the remote Olef Cloud server works
# without the CLI too, in a cloud-hosted workspace.
remote_mcp=""
if grep -qF 'mcp.shadowdroid.dev' "${CLAUDE_PLUGIN_ROOT}/.mcp.json" 2>/dev/null; then
  remote_mcp=1
fi

if [ "$toolchain" = missing ] && [ "$cloud" = linked ]; then
  if [ -n "$context" ]; then
    context+=" "
  fi
  context+="This project is linked to Olef Cloud with cloud mode on: olef commands build and run the app on a cloud emulator, so adb, the Android SDK and a JDK are not needed on this machine. Don't install them unless the user asks. 'olef cloud status' shows the session, and 'olef commands --guide cloud' covers usage, limits and cloud errors."
elif [ "$toolchain" = missing ]; then
  if [ -n "$context" ]; then
    context+=" "
  fi
  context+="adb (Android SDK platform-tools) was not found. Olef needs it to reach devices; Android Studio installs it, or install it with:"
  if [ "$os" = macos ]; then
    context+=" brew install --cask android-platform-tools."
    if [ -z "$notice" ]; then
      notice="Olef: adb was not found. Install Android platform-tools: brew install --cask android-platform-tools"
    fi
  elif [ "$os" = windows ]; then
    context+=" scoop install adb."
    if [ -z "$notice" ]; then
      notice="Olef: adb was not found. Install Android platform-tools: scoop install adb"
    fi
  else
    context+=" the distribution's package (for example: sudo apt install adb)."
    if [ -z "$notice" ]; then
      notice="Olef: adb was not found. Install Android platform-tools with the distribution's package (for example: sudo apt install adb)"
    fi
  fi
  # The install notices get the cloud option; the update notice stands alone.
  if [ "$cloud" = off ]; then
    context+=" This project is linked to Olef Cloud, but cloud mode is off. 'olef cloud on' runs it in the cloud again, with no Android SDK or adb here; ask the user which they want."
    if [ -z "$update" ]; then
      notice+=" Or run it in the cloud again: olef cloud on"
    fi
  elif [ "$cloud" = signed_in ]; then
    context+=" The user is signed in to Olef Cloud, but this folder isn't linked. Before installing anything, ask whether to set up Android locally or build and run in the cloud: 'olef cloud link' in the project's root uploads it once the user approves. 'olef commands --guide cloud' has the steps."
    if [ -z "$update" ]; then
      notice+=" Or no setup: build and run in the cloud (invite-only alpha), olef cloud link"
    fi
  elif [ "$cloud" != unsupported ]; then
    context+=" Or no setup: Olef Cloud builds and runs the app on a cloud emulator, with nothing else to install (an invite-only alpha). Before installing anything, ask the user which they want: set up Android locally, or Olef Cloud ('olef cloud login' signs them in through the browser, then 'olef cloud link' in the project's root uploads it once they approve). Never sign the user up, sign in or upload code without their yes. 'olef commands --guide cloud' has the steps."
    if [ -z "$update" ]; then
      notice+=" Or no setup: build and run in the cloud (invite-only alpha), olef cloud login"
    fi
  fi
fi
if [ "$cli" != ok ] && [ -n "$remote_mcp" ]; then
  context+=" This plugin also has the Olef Cloud MCP tools (mcp.shadowdroid.dev), which work without the CLI: the project then lives in a cloud-hosted workspace (create_workspace, write_files, build_and_run, screenshot, open_viewer, export_project), and the first call asks the user to sign in. Offer that or installing the CLI, which keeps the project in this folder, and let the user choose."
fi

[ -n "$context" ] || exit 0

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
# A project in cloud mode needs nothing from the user: context only.
if [ -z "$notice" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(json_escape "$context")"
  exit 0
fi
printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "$(json_escape "$notice")" "$(json_escape "$context")"
