#!/usr/bin/env bash
# SessionStart: when the shadowdroid CLI (or adb) is missing or too old, tell
# the agent how to install it on this OS and show the user a one-line note.
# Silent when everything is in place. Never installs anything itself: the
# agent offers the command and runs it only with the user's approval.
# Usage: check-cli [claude|codex] (the plugin it runs for; default claude).
# Both plugins ship this same file.
set -u

case "${1:-claude}" in
  codex)
    agent="Codex"
    reconnect="works immediately in the shell; the plugin's tools (control, build, boot, annotations, recording) start working in a new thread"
    ;;
  *)
    agent="Claude"
    reconnect="works immediately through Bash; the plugin's MCP tools (control, build, boot, annotations, recording) start working after the user runs /mcp and reconnects the shadowdroid server, or starts a new session"
    ;;
esac

# A literal path from the plugin root, so plugin directories can follow it.
# Codex's hook sets CLAUDE_PLUGIN_ROOT from its PLUGIN_ROOT. This hook runs
# programs only by their names, never from a path it computed.
# shellcheck source=../lib/plugin-env.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/plugin-env.sh"

os="$(sd_os)"
have_brew=""
brews=("$(command -v brew 2>/dev/null || true)")
if [ "${SHADOWDROID_PLUGIN_TEST_ISOLATE:-}" != 1 ]; then
  brews+=(/opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew)
fi
for brew in "${brews[@]}"; do
  [ -n "$brew" ] && [ -x "$brew" ] && { have_brew="$brew"; break; }
done
have_scoop="$(command -v scoop 2>/dev/null || command -v scoop.cmd 2>/dev/null || true)"

# Assignments here stand as statements (in `if`), never after && or ||:
# plugin directories read `[ … ] && x="$y"` as running a command whose name
# the shell computes, and refuse the plugin.
#
# The CLI on PATH is checked for its version. One installed where desktop
# apps' PATH doesn't reach only needs to exist: the MCP launcher checks its
# version when it starts it.
cli=missing
too_old=""
if command -v shadowdroid >/dev/null 2>&1; then
  version="$(shadowdroid --version 2>/dev/null)"
  version="$(sd_version_of "$version")"
  if [ -n "$version" ] && sd_version_at_least "$version" "$SHADOWDROID_MIN_VERSION"; then
    cli=ok
  else
    cli=old
    too_old="shadowdroid ${version:-?}"
  fi
fi
if [ "$cli" = missing ]; then
  others=("${SHADOWDROID_BIN:-}")
  if [ "${SHADOWDROID_PLUGIN_TEST_ISOLATE:-}" != 1 ]; then
    others+=(
      /opt/homebrew/bin/shadowdroid
      /usr/local/bin/shadowdroid
      /home/linuxbrew/.linuxbrew/bin/shadowdroid
      "$HOME/.local/bin/shadowdroid"
      "${LOCALAPPDATA:-/nonexistent}/Programs/shadowdroid/shadowdroid.exe"
      "$HOME/scoop/shims/shadowdroid.exe"
    )
  fi
  for other in "${others[@]}"; do
    [ -n "$other" ] && [ -x "$other" ] && { cli=ok; break; }
  done
fi

# How to install or update the CLI on this machine. Every message is built
# from literal text, each command spelled out: plugin directories refuse a
# hook whose messages tell the agent to run something held in a variable.
if [ "$os" = windows ]; then
  if [ -n "$have_scoop" ]; then tool=scoop; else tool=powershell; fi
elif [ -n "$have_brew" ]; then
  tool=brew
else
  tool=installer
fi
context=""
notice=""
if [ "$cli" = old ]; then
  context="The ShadowDroid plugin needs the shadowdroid CLI ${SHADOWDROID_MIN_VERSION} or newer; found ${too_old}."
  notice="ShadowDroid: the shadowdroid CLI is out of date. Ask ${agent} to update it, or run:"
elif [ "$cli" = missing ]; then
  context="The ShadowDroid plugin needs the shadowdroid CLI, which is not installed on this machine."
  notice="ShadowDroid: install the shadowdroid CLI to use this plugin. Ask ${agent}, or run:"
fi
if [ "$cli" = ok ]; then
  :
elif [ "$tool" = brew ] && [ "$cli" = old ]; then
  notice+=" brew update && brew upgrade shadowdroid"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): brew update && brew upgrade shadowdroid ."
elif [ "$tool" = brew ]; then
  notice+=" brew install shadowdroid-dev/tap/shadowdroid"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): brew install shadowdroid-dev/tap/shadowdroid ."
elif [ "$tool" = scoop ] && [ "$cli" = old ]; then
  notice+=" scoop update shadowdroid"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): scoop update shadowdroid ."
elif [ "$tool" = scoop ]; then
  notice+=" scoop bucket add shadowdroid https://github.com/shadowdroid-dev/scoop-bucket; scoop install shadowdroid"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): scoop bucket add shadowdroid https://github.com/shadowdroid-dev/scoop-bucket; scoop install shadowdroid ."
elif [ "$tool" = powershell ]; then
  notice+=" irm https://github.com/shadowdroid-dev/shadowdroid/releases/latest/download/shadowdroid-installer.ps1 | iex"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): irm https://github.com/shadowdroid-dev/shadowdroid/releases/latest/download/shadowdroid-installer.ps1 | iex . Run it in PowerShell; the installer puts shadowdroid.exe on the user's PATH."
else
  notice+=" curl --proto '=https' --tlsv1.2 -LsSf https://github.com/shadowdroid-dev/shadowdroid/releases/latest/download/shadowdroid-installer.sh | sh"
  context+=" Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): curl --proto '=https' --tlsv1.2 -LsSf https://github.com/shadowdroid-dev/shadowdroid/releases/latest/download/shadowdroid-installer.sh | sh . It installs to ~/.local/bin; add that to PATH if 'shadowdroid' is not found afterwards."
fi
if [ "$cli" != ok ]; then
  context+=" Afterwards 'shadowdroid --version' prints the version and the shadowdroid CLI ${reconnect}. The device service is installed on the first 'shadowdroid connect'. The CLI is free for individuals and teams up to 10 users (ShadowDroid License)."
fi

if ! command -v adb >/dev/null 2>&1 && ! sd_find_platform_tools; then
  if [ -n "$context" ]; then
    context+=" "
  fi
  context+="adb (Android SDK platform-tools) was not found. ShadowDroid needs it to reach devices; Android Studio installs it, or install it with:"
  if [ "$os" = macos ]; then
    context+=" brew install --cask android-platform-tools."
    if [ -z "$notice" ]; then
      notice="ShadowDroid: adb was not found. Install Android platform-tools: brew install --cask android-platform-tools"
    fi
  elif [ "$os" = windows ]; then
    context+=" scoop install adb."
    if [ -z "$notice" ]; then
      notice="ShadowDroid: adb was not found. Install Android platform-tools: scoop install adb"
    fi
  else
    context+=" the distribution's package (for example: sudo apt install adb)."
    if [ -z "$notice" ]; then
      notice="ShadowDroid: adb was not found. Install Android platform-tools with the distribution's package (for example: sudo apt install adb)"
    fi
  fi
fi

[ -n "$context" ] || exit 0

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "$(json_escape "$notice")" "$(json_escape "$context")"
