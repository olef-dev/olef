{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${PLUGIN_ROOT}\" bash \"${PLUGIN_ROOT}/hooks/check-cli\" codex",
            "timeout": 20,
            "statusMessage": "Checking Olef CLI and adb setup"
          }
        ]
      }
    ]
  }
}
