{
  "mcpServers": {
    "olef": {
      "command": "./bin/olef-mcp",
      "cwd": ".",
      "env_vars": [
        "PATH",
        "HOME",
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "JAVA_HOME",
        "OLEF_BIN",
        "OLEF_APK",
        "OLEF_RUNTIME_DIR",
        "OLEF_VIEWER"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 900,
      "env": {
        "OLEF_AGENT": "codex"
      }
    },
    "olef-cloud": {
      "type": "http",
      "url": "https://mcp.shadowdroid.dev/mcp",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 900
    }
  }
}
