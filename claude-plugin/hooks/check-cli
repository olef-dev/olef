#!/usr/bin/env bash
# SessionStart: when the shadowdroid CLI (or adb) is missing or too old, tell
# the agent how to install it on this OS and show the user a one-line note.
# Silent when everything is in place. Never installs anything itself: the
# agent offers the command and runs it only with the user's approval.
# Usage: check-cli [claude|codex] (the plugin it runs for; default claude).
# Both plugins ship this same file.
set -u

case "${1:-claude}" in
  codex)
    agent="Codex"
    reconnect="works immediately in the shell; the plugin's tools (control, build, boot, annotations, recording) start working in a new thread"
    ;;
  *)
    agent="Claude"
    reconnect="works immediately through Bash; the plugin's MCP tools (control, build, boot, annotations, recording) start working after the user runs /mcp and reconnects the shadowdroid server, or starts a new session"
    ;;
esac

# A literal path from the plugin root, so plugin directories can follow it.
# Codex's hook sets CLAUDE_PLUGIN_ROOT from its PLUGIN_ROOT.
# shellcheck source=../lib/find-shadowdroid.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/find-shadowdroid.sh"

os="$(sd_os)"
have_brew=""
brews=("$(command -v brew 2>/dev/null || true)")
[ "${SHADOWDROID_PLUGIN_TEST_ISOLATE:-}" = 1 ] ||
  brews+=(/opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew)
for brew in "${brews[@]}"; do
  [ -n "$brew" ] && [ -x "$brew" ] && { have_brew="$brew"; break; }
done
have_scoop="$(command -v scoop 2>/dev/null || command -v scoop.cmd 2>/dev/null || true)"

base="https://github.com/shadowdroid-dev/shadowdroid/releases/latest/download"
install_cmd() {  # <upgrade:0|1>
  case "$os" in
    windows)
      if [ -n "$have_scoop" ]; then
        if [ "$1" = 1 ]; then echo "scoop update shadowdroid"
        else echo "scoop bucket add shadowdroid https://github.com/shadowdroid-dev/scoop-bucket; scoop install shadowdroid"; fi
      else
        echo "powershell -ExecutionPolicy Bypass -c \"irm $base/shadowdroid-installer.ps1 | iex\""
      fi ;;
    *)
      if [ -n "$have_brew" ]; then
        if [ "$1" = 1 ]; then echo "brew update && brew upgrade shadowdroid"
        else echo "brew install shadowdroid-dev/tap/shadowdroid"; fi
      else
        echo "curl --proto '=https' --tlsv1.2 -LsSf $base/shadowdroid-installer.sh | sh"
      fi ;;
  esac
}

context=""
notice=""
if ! sd_find; then
  if [ -n "$SD_TOO_OLD" ]; then
    command="$(install_cmd 1)"
    context="The ShadowDroid plugin needs the shadowdroid CLI ${SHADOWDROID_MIN_VERSION} or newer; found ${SD_TOO_OLD}."
    notice="ShadowDroid: the shadowdroid CLI is out of date. Ask $agent to update it, or run: $command"
  else
    command="$(install_cmd 0)"
    context="The ShadowDroid plugin needs the shadowdroid CLI, which is not installed on this machine."
    notice="ShadowDroid: install the shadowdroid CLI to use this plugin. Ask $agent, or run: $command"
  fi
  context="$context Before using ShadowDroid, offer to run this command (with the user's approval; it downloads the CLI from the shadowdroid-dev releases on GitHub): $command ."
  case "$os" in
    windows) [ -z "$have_scoop" ] && context="$context Run it in PowerShell; the installer puts shadowdroid.exe on the user's PATH." ;;
    *) [ -z "$have_brew" ] && context="$context It installs to ~/.local/bin; add that to PATH if 'shadowdroid' is not found afterwards." ;;
  esac
  context="$context Afterwards 'shadowdroid --version' prints the version and the shadowdroid CLI $reconnect. The device service is installed on the first 'shadowdroid connect'. The CLI is free for individuals and teams up to 10 users (ShadowDroid License)."
fi

if ! command -v adb >/dev/null 2>&1 && ! sd_find_platform_tools; then
  case "$os" in
    macos) adb_cmd="brew install --cask android-platform-tools" ;;
    windows) adb_cmd="scoop install adb" ;;
    *) adb_cmd="the distribution's package (for example: sudo apt install adb)" ;;
  esac
  context="${context:+$context }adb (Android SDK platform-tools) was not found. ShadowDroid needs it to reach devices; Android Studio installs it, or install it with: $adb_cmd."
  [ -n "$notice" ] || notice="ShadowDroid: adb was not found. Install Android platform-tools: $adb_cmd"
fi

[ -n "$context" ] || exit 0

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "$(json_escape "$notice")" "$(json_escape "$context")"
