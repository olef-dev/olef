#!/usr/bin/env bash
# SessionStart hook for the ocloud plugin (Codex and Claude Code).
# Checks whether the `ocloud` CLI is installed and whether the user is signed
# in to Olef Cloud. Silent when ready. Never installs or signs in on its own.
# Usage: check-ocloud [claude|codex]
set -u

case "${1:-claude}" in
  codex) agent="Codex" ;;
  *) agent="Claude" ;;
esac

ocloud_bin=""
if command -v ocloud >/dev/null 2>&1; then
  ocloud_bin="ocloud"
elif [ "${OLEF_PLUGIN_TEST_ISOLATE:-}" != 1 ]; then
  for candidate in \
    /opt/homebrew/bin/ocloud \
    /usr/local/bin/ocloud \
    /home/linuxbrew/.linuxbrew/bin/ocloud \
    "$HOME/.local/bin/ocloud" \
    "$HOME/scoop/shims/ocloud.exe"; do
    if [ -x "$candidate" ]; then
      ocloud_bin="$candidate"
      break
    fi
  done
fi

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

context=""
notice=""

if [ -z "$ocloud_bin" ]; then
  if command -v brew >/dev/null 2>&1 || [ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ]; then
    notice="Olef Cloud: install the ocloud CLI to use this plugin. Ask ${agent}, or run: brew install olef-dev/tap/ocloud"
    context="The Olef Cloud plugin needs the ocloud CLI, which is not installed. Before running ocloud commands, offer to run (with the user's approval): brew install olef-dev/tap/ocloud"
  else
    notice="Olef Cloud: install the ocloud CLI to use this plugin (see https://olef.dev)."
    context="The Olef Cloud plugin needs the ocloud CLI, which is not installed. Offer to install it (with the user's approval) via Homebrew (brew install olef-dev/tap/ocloud) or from https://github.com/olef-dev/olef/releases."
  fi
else
  # Fast non-blocking check whether the user has signed in locally.
  auth_tmp="$(mktemp 2>/dev/null || true)"
  signed_in=unknown
  if [ -n "$auth_tmp" ]; then
    "$ocloud_bin" status --json >"$auth_tmp" 2>/dev/null </dev/null &
    pid=$!
    deadline=$((SECONDS + 3))
    while kill -0 "$pid" 2>/dev/null && [ "$SECONDS" -lt "$deadline" ]; do
      sleep 0.1
    done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    out="$(tr -d ' \t\r\n' <"$auth_tmp")"
    rm -f "$auth_tmp"
    case "$out" in
      *'"signed_in":true'* | *'"account":{'* | *'"linked":true'*) signed_in=yes ;;
      *'"signed_in":false'* | *'"code":"cloud_unauthenticated"'* | *'"not_signed_in"'*) signed_in=no ;;
    esac
  fi
  if [ "$signed_in" = no ]; then
    notice="Olef Cloud: not signed in yet. Run: ocloud login"
    context="The ocloud CLI is installed, but the user is not signed in to Olef Cloud yet. Before running cloud commands, ask the user if they want to run 'ocloud login' (never sign in without their approval)."
  fi
fi

[ -n "$context" ] || exit 0

if [ -z "$notice" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(json_escape "$context")"
  exit 0
fi

printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "$(json_escape "$notice")" "$(json_escape "$context")"
